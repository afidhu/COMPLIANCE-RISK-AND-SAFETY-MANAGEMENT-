{
  "compilerOptions": {
    "module": "esnext",               // ◄ Change from nodenext to esnext
    "moduleResolution": "bundler",    // ◄ Combines perfectly with esnext
    "target": "es2022",
    
    "noEmit": false,                  // ◄ MUST be false so Vercel can build your app files
    "outDir": "./dist",               // ◄ Tells the compiler where to save the files
    
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"]             // ◄ Makes sure all files inside src are compiled
}
